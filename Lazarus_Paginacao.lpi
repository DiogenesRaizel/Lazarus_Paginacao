        <IsPartOfProject Value="True"/>
        <UnitName Value="uNomesModel"/>
      </Unit>
      <Unit>
        <Filename Value="src/Model/ucidadesmodel.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uCidadesModel"/>
      </Unit>
      <Unit>
        <Filename Value="src/Controller/ucontrollerbase.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uControllerBase"/>
      </Unit>
      <Unit>
        <Filename Value="src/Controller/unomescontroller.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uNomesController"/>
      </Unit>
      <Unit>
        <Filename Value="src/Controller/ucidadescontroller.pas"/>

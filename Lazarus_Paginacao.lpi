  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/Lazarus_Paginacao"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="src;src/Model;src/Controller;src/View;src/DataModule"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>

procedure PrepararBanco(AConexao: TSQLConnection; ATransacao: TSQLTransaction);
var
  QExec: TSQLQuery;
  QConsulta: TSQLQuery;
  PostgreSQL: Boolean;
begin
  if AConexao = nil then
    raise Exception.Create('A conexão com o banco não foi informada.');

  if ATransacao = nil then
    raise Exception.Create('A transação não foi informada.');

  if not AConexao.Connected then
    raise Exception.Create('A conexão com o banco não está aberta.');

  PostgreSQL := Pos('PQConnection', AConexao.ClassName) > 0;

  if not PostgreSQL then
    AConexao.ExecuteDirect('PRAGMA foreign_keys = ON');

  QExec := TSQLQuery.Create(nil);
  QConsulta := TSQLQuery.Create(nil);

  try
    QExec.DataBase := AConexao;
    QExec.Transaction := ATransacao;

    QConsulta.DataBase := AConexao;
    QConsulta.Transaction := ATransacao;

    { 1. Cria primeiro a tabela cidades. }
    try
      if ATransacao.Active then
        ATransacao.Commit;

      ATransacao.StartTransaction;

      CriarTabelaCidades(QExec, PostgreSQL);
      CriarTabelaNomes(QExec, PostgreSQL);

      ATransacao.Commit;
    except
      if ATransacao.Active then
        ATransacao.Rollback;
      raise;
    end;

    { 2. Popula cidades antes de inserir nomes. }
    try
      ATransacao.StartTransaction;
      PopularTabelaCidades(QExec, QConsulta);
      ATransacao.Commit;
    except
      if ATransacao.Active then
        ATransacao.Rollback;
      raise;
    end;

    { 3. Associa cada nome a uma cidade aleatória. }
    try
      ATransacao.StartTransaction;
      Randomize;
      PopularTabelaNomes(QExec, QConsulta);
      ATransacao.Commit;
    except
      if ATransacao.Active then
        ATransacao.Rollback;
      raise;
    end;

  finally
    QConsulta.Free;
    QExec.Free;
  end;
end;


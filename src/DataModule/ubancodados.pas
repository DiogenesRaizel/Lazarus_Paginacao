unit uBancoDados;

{$mode ObjFPC}{$H+}

interface

uses
  Classes, SysUtils, SQLDB;

procedure PrepararBanco(AConexao: TSQLConnection; ATransacao: TSQLTransaction);

implementation

procedure ExecutarSQL(AQuery: TSQLQuery; const ASQL: string);
begin
  AQuery.Close;
  AQuery.SQL.Text := ASQL;
  AQuery.ExecSQL;
end;

function TabelaVazia(AQuery: TSQLQuery; const ATabela: string): Boolean;
begin
  AQuery.Close;
  AQuery.SQL.Text := 'SELECT COUNT(*) AS Total FROM ' + ATabela;
  AQuery.Open;

  try
    Result := AQuery.FieldByName('Total').AsInteger = 0;
  finally
    AQuery.Close;
  end;
end;

procedure CriarTabelaCidades(AQuery: TSQLQuery; APostgreSQL: Boolean);
begin
  if APostgreSQL then
    ExecutarSQL(AQuery,
      'CREATE TABLE IF NOT EXISTS cidades (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ' +
      'Cidade VARCHAR(100) NOT NULL, ' +
      'UF CHAR(2) NOT NULL' +
      ')')
  else
    ExecutarSQL(AQuery,
      'CREATE TABLE IF NOT EXISTS cidades (' +
      'ID INTEGER PRIMARY KEY AUTOINCREMENT, ' +
      'Cidade VARCHAR(100) NOT NULL, ' +
      'UF CHAR(2) NOT NULL' +
      ')');
end;

procedure CriarTabelaNomes(AQuery: TSQLQuery; APostgreSQL: Boolean);
begin
  if APostgreSQL then
    ExecutarSQL(AQuery,
      'CREATE TABLE IF NOT EXISTS nomes (' +
      'ID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ' +
      'Nome VARCHAR(60) NOT NULL, ' +
      'CidadeID INTEGER NOT NULL, ' +
      'FOREIGN KEY (CidadeID) REFERENCES cidades(ID)' +
      ')')
  else
    ExecutarSQL(AQuery,
      'CREATE TABLE IF NOT EXISTS nomes (' +
      'ID INTEGER PRIMARY KEY AUTOINCREMENT, ' +
      'Nome VARCHAR(60) NOT NULL, ' +
      'CidadeID INTEGER NOT NULL, ' +
      'FOREIGN KEY (CidadeID) REFERENCES cidades(ID)' +
      ')');
end;


object frmMain: TfrmMain
  Left = 0
  Height = 650
  Top = 0
  Width = 1280
  Caption = 'Principal'
  ClientHeight = 650
  ClientWidth = 1280
  Position = poScreenCenter
  LCLVersion = '5.99.0.0'
  OnCreate = FormCreate
  object pgMain: TPageControl
    Left = 0
    Height = 650
    Top = 0
    Width = 1280
    ActivePage = tsNomes
    Align = alClient
    Font.Height = -16
    Options = [nboShowCloseButtons]
    ParentFont = False
